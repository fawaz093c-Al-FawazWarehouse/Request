rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'pharmacyName', 'phone', 'address', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('pharmacyName' in data) || (data.pharmacyName is string && data.pharmacyName.size() <= 128))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
        && (!('address' in data) || (data.address is string && data.address.size() <= 256));
    }

    function isValidOrderDraft(data) {
      return data.keys().hasAll(['id', 'userId', 'pharmacyName', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'pharmacyName', 'pharmacistName', 'phone', 'address', 'notes', 'discountPercent', 'status', 'items', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.pharmacyName is string && data.pharmacyName.size() <= 128
        && data.status in ['draft', 'confirmed', 'delivered', 'archived']
        && (!('title' in data) || (data.title is string && data.title.size() <= 128))
        && (!('pharmacistName' in data) || (data.pharmacistName is string && data.pharmacistName.size() <= 128))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 64))
        && (!('address' in data) || (data.address is string && data.address.size() <= 256))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('discountPercent' in data) || (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100))
        && (!('items' in data) || (data.items is list && data.items.size() <= 300));
    }

    // User Profile Rules
    match /users/{userId} {
      allow get, delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;

      // User Order Drafts Subcollection
      match /drafts/{draftId} {
        allow get, list, delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() && isValidId(userId) && isValidId(draftId)
          && request.auth.uid == userId
          && isValidOrderDraft(incoming())
          && incoming().userId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(userId) && isValidId(draftId)
          && request.auth.uid == userId
          && isValidOrderDraft(incoming())
          && incoming().userId == existing().userId;
      }
    }
  }
}
