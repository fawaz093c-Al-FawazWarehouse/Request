{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and pharmacy profile details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "pharmacyName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "address": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "OrderDraft": {
      "title": "OrderDraft",
      "description": "Pharmacy drug order draft with calculation data and items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "pharmacyName": { "type": "string", "maxLength": 128 },
        "pharmacistName": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 64 },
        "address": { "type": "string", "maxLength": 256 },
        "notes": { "type": "string", "maxLength": 1000 },
        "discountPercent": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "confirmed", "delivered", "archived"] },
        "items": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "pharmacyName", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profile and pharmacy information"
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": "OrderDraft",
      "description": "Saved drug order drafts belonging to the authenticated user"
    }
  }
}
